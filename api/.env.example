# Postgres (Tiger Data connection string, include ?sslmode=require)
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require

# Meta Muse Spark (planner + chat fairy)
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3

# Google Gemini (screenshot parsing)
GEMINI_API_KEY=

# SerpApi (place enrichment)
SERPAPI_KEY=

# Capital One Nessie (money)
NESSIE_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to 1 to force cached API responses (demo safety net)
USE_CACHE=0

# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
NESSIE_BASE_URL=http://api.nessieisreal.com
